# Stream (same key as backend)
VITE_STREAM_API_KEY=

# Backend URL for token + AI agent (e.g. http://localhost:8000)
VITE_AI_ASSISTANT_URL=

# The active channel comes from the join code in the URL (?c=<code>), not from env.
VITE_PROTECTED_CHANNELS=dev2   # channels where the Clear button is hidden (comma-separated)
