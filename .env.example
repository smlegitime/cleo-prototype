# Required — LLM provider (choose one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=         # also required for embeddings regardless of MODEL_PROVIDER

# Model provider: anthropic (default), openai, or ollama
MODEL_PROVIDER=anthropic
OLLAMA_MODEL=llama3.2:latest   # only used when MODEL_PROVIDER=ollama

# Required — Stream Chat
STREAM_API_KEY=
STREAM_API_SECRET=
STREAM_CHANNEL_ID=general      # channel used when a link carries no ?c= join code (also the /chat default)
STREAM_CHANNELS=dev2,general   # allowlist of joinable channels (comma-separated) — one per group; join code = channel id
PROTECTED_CHANNELS=dev2        # channels the in-app "Clear channel" button refuses to wipe
STREAM_JOIN_ALL_CHANNELS=false # true = legacy demo mode: one global user per name, joined to every channel
AI_USER_ID=ai-assistant
AI_USER_NAME=AI Assistant

# Required for the generate stage — Bluesky corpus fetch.
# One shared, service-level, READ-ONLY app password (NOT a labeler's own identity). A throwaway
# account is fine. Without these, the generate stage can't fetch posts to test the rules against,
# and the flow stops before the sandbox run. Handle is the bare handle (no leading @).
BSKY_HANDLE=            # e.g. cleo-corpus.bsky.social
BSKY_APP_PASSWORD=      # create under Bluesky Settings → App Passwords

# Optional — where the frontend is served. Used to build the preview / maintenance-guide links CLEO
# posts in chat (e.g. {FRONTEND_URL}/?preview=<id>, /?guide=<id>). Defaults to the local Vite server.
FRONTEND_URL=http://localhost:5173

# Optional — operator export gate. Guards GET /export-state/<channel_id>, which dumps a channel's
# full checkpoint state (conversation + design). Generate with `openssl rand -hex 32` and set the
# SAME value on the server and in the shell that calls it. Leave blank to disable the route.
CLEO_ADMIN_TOKEN=

# Optional — LangSmith tracing
LANGSMITH_API_KEY=